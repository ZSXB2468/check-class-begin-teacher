# 签到系统配置文件示例

# 当前课堂ID（用于区分不同的签到历史）
class_id: '2024-class-001'

# 签到密码
password: 'checkin123'

# API服务器配置
api_server:
  host: '0.0.0.0'  # 监听所有网络接口
  port: 5000        # 监听端口

# 学生机IP地址到学生ID的映射
# 格式: 'IP地址': '学生ID'
student_ip_mapping:
  '192.168.1.101': 'student001'
  '192.168.1.102': 'student002'
  '192.168.1.103': 'student003'
  '192.168.1.104': 'student004'
  '192.168.1.105': 'student005'
